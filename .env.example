# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

# ── Banco de dados ──────────────────────────────────────────
POSTGRES_DB=odonto
POSTGRES_USER=odonto
POSTGRES_PASSWORD=odonto

# ── JWT ─────────────────────────────────────────────────────
# Gere um secret forte em produção:
# openssl rand -base64 64
JWT_SECRET=changeme-use-a-strong-secret-in-production
JWT_EXPIRATION_MS=86400000   # 24h em ms

# ── Spring Profile ──────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── PgAdmin (opcional, profile: tools) ──────────────────────
PGADMIN_EMAIL=admin@odonto.local
PGADMIN_PASSWORD=admin
