# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env
#
# Estas variáveis são lidas tanto pelo application.yml (execução com ./mvnw
# spring-boot:run) quanto pelo docker-compose.yml. NUNCA versione segredos reais.

# ── Banco de dados (conexão da aplicação) ───────────────────
# Ao rodar via docker-compose, o host é "postgres" (nome do serviço).
# Ao rodar localmente com ./mvnw, use "localhost".
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/odonto
SPRING_DATASOURCE_USERNAME=odonto
SPRING_DATASOURCE_PASSWORD=odonto

# ── Banco de dados (criação do container Postgres no docker-compose) ─
POSTGRES_DB=odonto
POSTGRES_USER=odonto
POSTGRES_PASSWORD=odonto

# ── JWT ─────────────────────────────────────────────────────
# Gere um secret forte em produção (HS512 exige >= 64 bytes):
# openssl rand -base64 64
JWT_SECRET=changeme-use-a-strong-secret-in-production
JWT_EXPIRATION_MS=86400000   # 24h em ms

# ── CORS ────────────────────────────────────────────────────
# Origens (frontend) autorizadas, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── E-mail (SMTP) — obrigatório para o fluxo de primeiro acesso ─
# Para Gmail, gere uma "Senha de app" (não use a senha da conta).
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app

# ── Spring Profile ──────────────────────────────────────────
# Perfis disponíveis: "local" (application-local.yml). Deixe vazio para o perfil base.
# OBS: não existe um perfil "dev" no projeto — não use esse valor.
SPRING_PROFILES_ACTIVE=local

# ── PgAdmin (opcional, docker compose --profile tools) ──────
PGADMIN_EMAIL=admin@odonto.local
PGADMIN_PASSWORD=admin
